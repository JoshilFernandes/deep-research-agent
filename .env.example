# Copy this file to .env and fill in your keys. Nothing here is required
# to run the test suite or `eval/run_eval.py --mock` -- only to run the
# real API/frontend against a live model and live search.

# --- LLM provider -----------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
# Groq's available model lineup changes over time and varies by account/
# key tier -- if you get a 404 "model does not exist" error, check what
# your key can access with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
DEEP_RESEARCH_MODEL=openai/gpt-oss-120b

# --- Search provider ----------------------------------------------------
# Recommended: a free Tavily key (https://tavily.com) gives much better
# results than the no-key DuckDuckGo fallback.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# If TAVILY_API_KEY is left blank, the app automatically falls back to
# DuckDuckGo's no-key HTML endpoint (set SEARCH_PROVIDER=duckduckgo to
# force this explicitly).
